# Copy to .env and fill in real values. .env is gitignored; this file is not
# and must never contain real secrets.

# Required. Sent in the acquisition User-Agent so hosts can identify/contact us.
LEDGERLIGHT_CONTACT_EMAIL=you@example.com

# Optional (defaults shown). Root directory for data/raw,interim,processed,manifests.
LEDGERLIGHT_DATA_DIR=data

# Optional (defaults shown). Polite-fetcher behaviour.
LEDGERLIGHT_FETCH_RATE_LIMIT_SECONDS=2.0
LEDGERLIGHT_FETCH_TIMEOUT_SECONDS=30.0
LEDGERLIGHT_FETCH_MAX_RETRIES=5
LEDGERLIGHT_FETCH_MAX_FILE_SIZE_BYTES=200000000

# Optional (defaults shown). Local Docker Compose infra only — never used in
# production, never real credentials.
LEDGERLIGHT_POSTGRES_HOST=127.0.0.1
LEDGERLIGHT_POSTGRES_PORT=55432
LEDGERLIGHT_POSTGRES_USER=ledgerlight
LEDGERLIGHT_POSTGRES_PASSWORD=changeme-local-only
LEDGERLIGHT_POSTGRES_DB=ledgerlight

LEDGERLIGHT_MINIO_ENDPOINT=127.0.0.1:59000
LEDGERLIGHT_MINIO_ROOT_USER=ledgerlight
LEDGERLIGHT_MINIO_ROOT_PASSWORD=changeme-local-only
