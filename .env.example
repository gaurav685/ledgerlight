# Copy to .env and fill in real values. .env is gitignored; this file is not
# and must never contain real secrets.

# Required. Sent in the acquisition User-Agent so hosts can identify/contact us.
LEDGERLIGHT_CONTACT_EMAIL=you@example.com

# Optional (defaults shown). Root directory for data/raw,interim,processed,manifests.
LEDGERLIGHT_DATA_DIR=data

# Optional (defaults shown). Polite-fetcher behaviour.
LEDGERLIGHT_FETCH_RATE_LIMIT_SECONDS=2.0
LEDGERLIGHT_FETCH_TIMEOUT_SECONDS=30.0
LEDGERLIGHT_FETCH_MAX_RETRIES=5
LEDGERLIGHT_FETCH_MAX_FILE_SIZE_BYTES=200000000

# Optional (defaults shown). Local Docker Compose infra only — never used in
# production, never real credentials.
LEDGERLIGHT_POSTGRES_HOST=127.0.0.1
LEDGERLIGHT_POSTGRES_PORT=55432
LEDGERLIGHT_POSTGRES_USER=ledgerlight
LEDGERLIGHT_POSTGRES_PASSWORD=changeme-local-only
LEDGERLIGHT_POSTGRES_DB=ledgerlight

# Generic S3-compatible endpoint for local infra (Garage — see
# docs/adr/0003-object-storage.md). No static access key/secret here:
# scripts/infra_check.py provisions a fresh key via Garage's admin CLI
# on each run.
LEDGERLIGHT_S3_ENDPOINT=127.0.0.1:59000
LEDGERLIGHT_S3_REGION=garage

# Persistent raw-object bucket/key (Phase 1) -- written automatically by
# `uv run python scripts/garage_provision.py` on first run; leave blank
# until then.
LEDGERLIGHT_S3_BUCKET=ledgerlight-raw
LEDGERLIGHT_S3_ACCESS_KEY_ID=
LEDGERLIGHT_S3_SECRET_ACCESS_KEY=

# Optional (default shown). Dagster's own run/event/schedule storage lives
# in this separate database on the same Postgres server -- never the
# application schema above. See docs/adr/0004-metadata-store-and-orchestration.md.
LEDGERLIGHT_POSTGRES_DAGSTER_DB=ledgerlight_dagster

# Required for `docker compose -f infra/docker-compose.yml up`. Read only by
# Docker Compose (not by the Python app) — generate real local-only values,
# never reuse these for anything beyond the loopback-bound dev container:
#   LEDGERLIGHT_GARAGE_RPC_SECRET=$(openssl rand -hex 32)
#   LEDGERLIGHT_GARAGE_ADMIN_TOKEN=$(openssl rand -hex 16)
LEDGERLIGHT_GARAGE_RPC_SECRET=
LEDGERLIGHT_GARAGE_ADMIN_TOKEN=

# Phase 5 §5. "dev" (the default) exempts every weak default below from
# the real fail-fast check in ledgerlight/config/settings.py -- set this
# to "staging" or "production" only once every one of those has a real,
# distinct value (never reuse these for anything beyond localhost dev).
LEDGERLIGHT_ENVIRONMENT=dev

# Phase 5 §2. The API's own restricted runtime DB role (never the owner
# role migrations run under -- see docs/adr/0008-api-auth-tenancy.md).
# Created by migration 4dad2cd00443; this password must match what you
# set there if you ever change it from the default.
LEDGERLIGHT_APP_DB_USER=ledgerlight_app
LEDGERLIGHT_APP_DB_PASSWORD=changeme-local-only-app

# Phase 5 §2. Session-token hashing and webhook-secret encryption-at-rest
# keys. The defaults below are real, valid, but deliberately dev-only --
# never used outside LEDGERLIGHT_ENVIRONMENT=dev. Generate real values
# for anything else:
#   LEDGERLIGHT_SESSION_SECRET_KEY=$(openssl rand -hex 32)
#   LEDGERLIGHT_WEBHOOK_SECRET_ENCRYPTION_KEY=$(uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
LEDGERLIGHT_SESSION_SECRET_KEY=dev-only-session-secret-change-me
LEDGERLIGHT_WEBHOOK_SECRET_ENCRYPTION_KEY=UWhA93WPMUQ7e0aYCYjBP_nKSse4xZ0Bf6qC1TxZDyw=  # gitleaks:allow

# Phase 5 §3. False on plain-http localhost dev; set true for any real
# deployment served over TLS (required outside LEDGERLIGHT_ENVIRONMENT=dev).
LEDGERLIGHT_COOKIE_SECURE=false

# Phase 5 §5. Where the frontend's own Next.js server proxies /api/* to --
# only read by `frontend/next.config.ts`, never by the Python app. Set to
# the real `api` service's Compose DNS name when running the full stack
# (see infra/docker-compose.yml); the default below is for running
# `pnpm dev` directly against a locally-run `uvicorn` process.
LEDGERLIGHT_API_ORIGIN=http://127.0.0.1:8000
