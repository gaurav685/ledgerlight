# --- secrets / env ---
.env
.env.*
!.env.example

# --- data (raw/derived content is never committed; manifests are) ---
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/manifests/
!data/README.md

# --- databases / local state ---
*.db
*.sqlite
*.sqlite3

# --- infra volumes (Postgres / MinIO local state) ---
infra/pgdata/
infra/garagedata/
infra/garagemeta/

# --- Dagster local runtime state (run storage itself is in Postgres;
#     dagster.yaml is config, not state, and IS committed) ---
dagster_home/storage/
dagster_home/logs/
dagster_home/compute_logs/
dagster_home/history/
dagster_home/schedules/
dagster_home/.telemetry/
dagster_home/*.db

# --- manual-import inbox (local-only staging for exchange-only documents) ---
data/inbox/
infra/*.volume/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- Node (recorded version only in Phase 0; no app scaffolded yet) ---
node_modules/

# --- Claude Code local settings ---
.claude/

# --- caches ---
.cache/
.uv-cache/

# --- Phase 2 knowledge-pipeline artifacts (rebuildable, never committed) ---
# Pretrained model weights (bge-small-en-v1.5, DeBERTa-v3) are fetched by
# sentence-transformers/transformers on first use into the OS-default
# Hugging Face cache (~/.cache/huggingface/hub on this machine), not into
# this repo -- nothing under the repo root needs gitignoring for them.
data/indexes/
data/models/

# --- Phase 5 §6: Terraform local state/provider cache (infra/aws/ is
#     validate-only in this phase -- never applied; .terraform.lock.hcl
#     IS committed, per Terraform's own convention, everything else
#     under .terraform/ and every real *.tfstate* file are not) ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# --- Phase 6A §7: the dossier-review sample's manifest and answer key
#     deliberately mix 10 real + ~3 seeded-QC dossiers UNLABELLED to a
#     real human reviewer -- both files record (or directly reveal)
#     which review_task_ids are seeded, so committing either one to a
#     tracked repo would let anyone `git show`/grep the real answer
#     before reviewing. Unlike other generated manifests in this
#     project (e.g. data/manifests/label-review-sample-*.jsonl, which
#     ARE committed), these two stay local-only. The tool that
#     generates them (scripts/build_dossier_review_sample.py) is
#     committed and re-runnable. ---
docs/phase-6/review-pack/dossier-review-manifest.jsonl
docs/phase-6/review-pack/dossier-review-answer-key.jsonl

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
