SQL:

SELECT feature_set_version,
       count(*) AS total_rows,
       count(*) FILTER (WHERE max_input_known_at IS NOT NULL) AS rows_with_known_at,
       count(*) FILTER (WHERE max_input_known_at IS NULL) AS rows_with_no_real_input,
       count(*) FILTER (WHERE max_input_known_at IS NOT NULL AND max_input_known_at::date <= as_of) AS satisfying,
       count(*) FILTER (WHERE max_input_known_at IS NOT NULL AND max_input_known_at::date > as_of) AS violating
FROM feature_snapshots
GROUP BY feature_set_version
ORDER BY feature_set_version;

